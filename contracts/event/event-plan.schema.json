{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.activity.invalid/v1/event-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "activity.event-plan.v1"
    },
    "status": {
      "description": "Lifecycle state of this plan. published is the only state the delivery layer accepts as an active release manifest; draft_example_not_published marks authoring examples and fixtures that must never be treated as an active release.",
      "enum": [
        "draft_example_not_published",
        "published"
      ]
    },
    "project_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "environment": {
      "description": "Target release environment. Releases are immutable per project and environment, and a machine credential is scoped to one environment; events are accepted only when their event version is published for that environment.",
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "release_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "envelope_contract": {
      "type": "object"
    },
    "system_event_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_key": {
            "type": "string",
            "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
            "maxLength": 68
          },
          "schema_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "event_key",
          "schema_version"
        ]
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_key": {
            "type": "string",
            "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
            "maxLength": 68
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "schema_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "allowed_source_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "description": "Ingestion source kind allowed to send this event: browser for the first-party browser SDK, server for trusted server collectors. The list is unique, holds at most these two kinds, is required at publication, and cannot include browser when fact_kind is server_confirmed.",
              "enum": [
                "browser",
                "server"
              ]
            }
          },
          "fact_kind": {
            "description": "Trust classification of the fact: user_intent is a deliberate user action, client_observed is browser-observed behavior without an explicit intent claim, server_confirmed is asserted by a trusted server and therefore cannot permit a browser source. Required at publication; any other value fails closed.",
            "enum": [
              "user_intent",
              "client_observed",
              "server_confirmed"
            ]
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "schema": {
            "type": "object"
          },
          "field_metadata": {
            "type": "object"
          },
          "example_properties": {
            "type": "object",
            "maxProperties": 50,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "oneOf": [
                    {
                      "type": "string",
                      "maxLength": 1024
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "number",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  ]
                },
                {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "maxLength": 1024
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "number",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    ]
                  }
                }
              ]
            }
          },
          "implementation_status": {
            "type": "string"
          }
        },
        "required": [
          "event_key",
          "display_name",
          "schema_version",
          "allowed_source_kinds",
          "fact_kind",
          "trigger",
          "schema",
          "example_properties"
        ]
      }
    },
    "implementation_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "format",
    "status",
    "project_key",
    "environment",
    "release_revision",
    "events"
  ]
}
