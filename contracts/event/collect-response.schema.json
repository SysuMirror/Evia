{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.activity.invalid/v1/collect-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "event_id": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "const": "accepted"
              }
            },
            "required": [
              "index",
              "event_id",
              "status"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "event_id": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "const": "rejected"
              },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]+$"
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "field_paths": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "maxLength": 256
                    }
                  }
                },
                "required": [
                  "code",
                  "retryable"
                ]
              }
            },
            "required": [
              "index",
              "status",
              "error"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "batch_id",
    "receipt_id",
    "results"
  ]
}
