{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.activity.invalid/v1/collect-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "write_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "event-envelope.schema.json"
      }
    }
  },
  "required": [
    "protocol_version",
    "batch_id",
    "write_key",
    "sent_at",
    "events"
  ]
}
