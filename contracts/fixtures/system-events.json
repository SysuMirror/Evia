{
  "format": "activity.system-events.v1",
  "events": [
    {
      "event_key": "sys.page_view",
      "display_name": "页面访问",
      "schema_version": 1,
      "allowed_source_kinds": [
        "browser"
      ],
      "fact_kind": "client_observed",
      "trigger": "成功导航并生成新page_view_id后。",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "example_properties": {}
    },
    {
      "event_key": "sys.page_scroll",
      "display_name": "页面滚动片段",
      "schema_version": 1,
      "allowed_source_kinds": [
        "browser"
      ],
      "fact_kind": "client_observed",
      "trigger": "滚动停止后合并片段，最多12条每分钟。",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "to_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "max_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "direction": {
            "enum": [
              "up",
              "down",
              "mixed"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "from_ratio",
          "to_ratio",
          "max_ratio",
          "direction",
          "duration_ms"
        ]
      },
      "example_properties": {
        "from_ratio": 0,
        "to_ratio": 0.6,
        "max_ratio": 0.6,
        "direction": "down",
        "duration_ms": 3000
      }
    },
    {
      "event_key": "sys.heatmap_click",
      "display_name": "热力图点击",
      "schema_version": 1,
      "allowed_source_kinds": [
        "browser"
      ],
      "fact_kind": "client_observed",
      "trigger": "用户完成可点击元素的激活（指针或键盘）后，携带视口坐标与元素定位；每分钟限速。",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "viewport_width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "viewport_height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "element_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "element_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "required": [
          "x_ratio",
          "y_ratio",
          "viewport_width",
          "viewport_height",
          "element_path"
        ]
      },
      "example_properties": {
        "x_ratio": 0.5,
        "y_ratio": 0.32,
        "viewport_width": 1366,
        "viewport_height": 900,
        "element_path": "main>div.list>button.primary",
        "element_index": 2
      }
    },
    {
      "event_key": "sys.content_chunk",
      "display_name": "敏感内容密文分片",
      "schema_version": 1,
      "allowed_source_kinds": [
        "browser"
      ],
      "fact_kind": "client_observed",
      "trigger": "业务通过 SDK 通用密文内容 API 提交已加密内容分片。",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "content_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "stream_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "actor_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "chunk_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "chunk_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "ciphertext": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5483
          },
          "nonce": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "wrapped_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "key_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "alg": {
            "enum": [
              "A256GCM+RSA-OAEP-256"
            ]
          },
          "aad_version": {
            "enum": [
              "evia-content-v1"
            ]
          },
          "padding": {
            "description": "Authenticated fixed plaintext block mode. fixed-600-v1 preserves the chat-compatible 600-byte block with at most 598 payload bytes; fixed-4096-v2 uses a 4096-byte block with at most 4094 payload bytes for higher-volume generic content.",
            "enum": [
              "fixed-600-v1",
              "fixed-4096-v2"
            ]
          },
          "content_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "truncated": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "maxLength": 32
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "padding": {
                  "const": "fixed-600-v1"
                }
              },
              "required": [
                "padding"
              ]
            },
            "then": {
              "properties": {
                "ciphertext": {
                  "maxLength": 1024
                }
              }
            }
          }
        ],
        "required": [
          "content_type",
          "stream_id",
          "item_id",
          "actor_type",
          "chunk_index",
          "chunk_count",
          "ciphertext",
          "nonce",
          "wrapped_key",
          "key_id",
          "alg",
          "aad_version",
          "padding",
          "content_length",
          "truncated"
        ]
      },
      "example_properties": {
        "content_type": "ai_chat_message",
        "stream_id": "stream-1",
        "item_id": "item-1",
        "actor_type": "user",
        "chunk_index": 0,
        "chunk_count": 1,
        "ciphertext": "ciphertext",
        "nonce": "nonce",
        "wrapped_key": "wrapped",
        "key_id": "key-1",
        "alg": "A256GCM+RSA-OAEP-256",
        "aad_version": "evia-content-v1",
        "padding": "fixed-600-v1",
        "content_length": 12,
        "truncated": false
      }
    },
    {
      "event_key": "sys.identity_link",
      "display_name": "当前会话身份关联",
      "schema_version": 1,
      "allowed_source_kinds": [
        "browser"
      ],
      "fact_kind": "client_observed",
      "trigger": "identify产生，uid与anonymous_id位于identity，不采凭据。",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "example_properties": {}
    },
    {
      "event_key": "sys.session_end",
      "display_name": "可观察到的会话结束",
      "schema_version": 1,
      "allowed_source_kinds": [
        "browser"
      ],
      "fact_kind": "client_observed",
      "trigger": "显式退出、切换账号或空闲结算。",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "enum": [
              "logout",
              "account_switch",
              "idle"
            ]
          }
        },
        "required": [
          "reason"
        ]
      },
      "example_properties": {
        "reason": "logout"
      }
    },
    {
      "event_key": "sys.operation_failed",
      "display_name": "逻辑操作失败",
      "schema_version": 1,
      "allowed_source_kinds": [
        "browser"
      ],
      "fact_kind": "client_observed",
      "trigger": "最终失败一次；不包含原始异常或业务请求正文。",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "error_category": {
            "enum": [
              "validation",
              "network",
              "timeout",
              "http",
              "business"
            ]
          },
          "error_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "operation",
          "error_category",
          "retryable"
        ]
      },
      "example_properties": {
        "operation": "post_like",
        "error_category": "business",
        "error_code": "REJECTED",
        "retryable": false
      }
    }
  ]
}
