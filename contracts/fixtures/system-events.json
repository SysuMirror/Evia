{
  "format": "activity.system-events.v1",
  "events": [
    {
      "event_key": "sys.page_view",
      "display_name": "页面访问",
      "schema_version": 1,
      "allowed_source_kinds": [
        "browser"
      ],
      "fact_kind": "client_observed",
      "trigger": "成功导航并生成新page_view_id后。",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "example_properties": {}
    },
    {
      "event_key": "sys.page_scroll",
      "display_name": "页面滚动片段",
      "schema_version": 1,
      "allowed_source_kinds": [
        "browser"
      ],
      "fact_kind": "client_observed",
      "trigger": "滚动停止后合并片段，最多12条每分钟。",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "to_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "max_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "direction": {
            "enum": [
              "up",
              "down",
              "mixed"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "from_ratio",
          "to_ratio",
          "max_ratio",
          "direction",
          "duration_ms"
        ]
      },
      "example_properties": {
        "from_ratio": 0,
        "to_ratio": 0.6,
        "max_ratio": 0.6,
        "direction": "down",
        "duration_ms": 3000
      }
    },
    {
      "event_key": "sys.identity_link",
      "display_name": "当前会话身份关联",
      "schema_version": 1,
      "allowed_source_kinds": [
        "browser"
      ],
      "fact_kind": "client_observed",
      "trigger": "identify产生，uid与anonymous_id位于identity，不采凭据。",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "example_properties": {}
    },
    {
      "event_key": "sys.session_end",
      "display_name": "可观察到的会话结束",
      "schema_version": 1,
      "allowed_source_kinds": [
        "browser"
      ],
      "fact_kind": "client_observed",
      "trigger": "显式退出、切换账号或空闲结算。",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "enum": [
              "logout",
              "account_switch",
              "idle"
            ]
          }
        },
        "required": [
          "reason"
        ]
      },
      "example_properties": {
        "reason": "logout"
      }
    },
    {
      "event_key": "sys.operation_failed",
      "display_name": "逻辑操作失败",
      "schema_version": 1,
      "allowed_source_kinds": [
        "browser"
      ],
      "fact_kind": "client_observed",
      "trigger": "最终失败一次；不包含原始异常或业务请求正文。",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "error_category": {
            "enum": [
              "validation",
              "network",
              "timeout",
              "http",
              "business"
            ]
          },
          "error_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "operation",
          "error_category",
          "retryable"
        ]
      },
      "example_properties": {
        "operation": "post_like",
        "error_category": "business",
        "error_code": "REJECTED",
        "retryable": false
      }
    }
  ]
}
