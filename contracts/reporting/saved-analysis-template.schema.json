{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.evia.invalid/v1/saved-analysis-template.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "trend",
        "funnel",
        "retention",
        "segment",
        "path",
        "attribution"
      ]
    },
    "event_versions": {
      "$ref": "../query/query-request.schema.json#/properties/event_versions"
    },
    "filter": {
      "$ref": "../query/query-request.schema.json#/properties/filter"
    },
    "subject": {
      "$ref": "../query/query-request.schema.json#/properties/subject"
    },
    "group_by": {
      "$ref": "../query/query-request.schema.json#/properties/group_by"
    },
    "metrics": {
      "$ref": "../query/query-request.schema.json#/properties/metrics"
    },
    "interval": {
      "$ref": "../query/query-request.schema.json#/properties/interval"
    },
    "funnel": {
      "$ref": "../query/query-request.schema.json#/properties/funnel"
    },
    "limit": {
      "$ref": "../query/query-request.schema.json#/properties/limit"
    },
    "retention": {
      "$ref": "../query/query-request.schema.json#/properties/retention"
    },
    "segment": {
      "$ref": "../query/query-request.schema.json#/properties/segment"
    },
    "path": {
      "$ref": "../query/query-request.schema.json#/properties/path"
    },
    "attribution": {
      "$ref": "../query/query-request.schema.json#/properties/attribution"
    }
  },
  "required": [
    "kind"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "trend"
          }
        }
      },
      "then": {
        "required": [
          "event_versions"
        ],
        "not": {
          "required": [
            "funnel"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "funnel"
          }
        }
      },
      "then": {
        "required": [
          "funnel",
          "subject"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "event_versions"
              ]
            },
            {
              "required": [
                "group_by"
              ]
            },
            {
              "required": [
                "metrics"
              ]
            },
            {
              "required": [
                "interval"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "retention"
          }
        }
      },
      "then": {
        "required": [
          "retention",
          "subject"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "event_versions"
              ]
            },
            {
              "required": [
                "group_by"
              ]
            },
            {
              "required": [
                "metrics"
              ]
            },
            {
              "required": [
                "interval"
              ]
            },
            {
              "required": [
                "funnel"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "segment"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "subject"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "event_versions"
              ]
            },
            {
              "required": [
                "group_by"
              ]
            },
            {
              "required": [
                "metrics"
              ]
            },
            {
              "required": [
                "interval"
              ]
            },
            {
              "required": [
                "funnel"
              ]
            },
            {
              "required": [
                "retention"
              ]
            },
            {
              "required": [
                "path"
              ]
            },
            {
              "required": [
                "attribution"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "path"
          }
        }
      },
      "then": {
        "required": [
          "path",
          "subject"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "event_versions"
              ]
            },
            {
              "required": [
                "group_by"
              ]
            },
            {
              "required": [
                "metrics"
              ]
            },
            {
              "required": [
                "interval"
              ]
            },
            {
              "required": [
                "funnel"
              ]
            },
            {
              "required": [
                "retention"
              ]
            },
            {
              "required": [
                "segment"
              ]
            },
            {
              "required": [
                "attribution"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "attribution"
          }
        }
      },
      "then": {
        "required": [
          "attribution",
          "subject"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "event_versions"
              ]
            },
            {
              "required": [
                "group_by"
              ]
            },
            {
              "required": [
                "metrics"
              ]
            },
            {
              "required": [
                "interval"
              ]
            },
            {
              "required": [
                "funnel"
              ]
            },
            {
              "required": [
                "retention"
              ]
            },
            {
              "required": [
                "segment"
              ]
            },
            {
              "required": [
                "path"
              ]
            }
          ]
        }
      }
    }
  ],
  "description": "Context-free saved query configuration. Event versions and funnel steps pin immutable facts; execution supplies environment, time_range and timezone. Semantic validation enforces version ownership of every property reference."
}
