{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.activity.invalid/v1/query-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query_id": {
      "type": "string",
      "format": "uuid"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "type"
        ]
      }
    },
    "rows": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data_watermark": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "当前查询实际观察到的最晚 received_at，空数据为 null，不代表所有分区已完整到达或统计已最终确定。"
        },
        "identity_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "仅在实际使用已存在的身份关系快照时返回；原始 UID 或匿名标识查询省略此字段。"
        },
        "accuracy": {
          "description": "本次结果的精度口径：exact 为精确计算；approximate 仅 unique 与 p50/p90/p95/p99 百分位在请求显式指定时出现，由近似算法产生；漏斗、留存、分群、路径、归因等非指标引擎恒为 not_applicable。",
          "enum": [
            "exact",
            "approximate",
            "not_applicable"
          ]
        },
        "sample_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "time_range": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string",
                  "format": "date-time"
                },
                "to": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "from",
                "to"
              ]
            },
            "state": {
              "description": "数据覆盖的结算状态。当前引擎恒为 provisional：不证明分区已完整到达，known_gaps 显式列出尚未建立的流水线完整性与未应用的身份关联；settled 预留给完整性已确立的未来结算流程，partial 预留给已确认存在覆盖缺口的场景，当前版本均不会产出这两个值。",
              "enum": [
                "provisional",
                "settled",
                "partial"
              ]
            },
            "known_gaps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "time_range",
            "state",
            "known_gaps"
          ]
        },
        "cache_hit": {
          "type": "boolean"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "data_watermark",
        "accuracy",
        "sample_rate",
        "coverage",
        "cache_hit",
        "generated_at"
      ]
    }
  },
  "required": [
    "query_id",
    "columns",
    "rows",
    "metadata"
  ]
}
