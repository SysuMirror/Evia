{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.activity.invalid/v1/query-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query_id": {
      "type": "string",
      "format": "uuid"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "type"
        ]
      }
    },
    "rows": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data_watermark": {
          "type": "string",
          "format": "date-time"
        },
        "identity_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "accuracy": {
          "enum": [
            "exact",
            "approximate",
            "not_applicable"
          ]
        },
        "sample_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "time_range": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string",
                  "format": "date-time"
                },
                "to": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "from",
                "to"
              ]
            },
            "state": {
              "enum": [
                "provisional",
                "settled",
                "partial"
              ]
            },
            "known_gaps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "time_range",
            "state",
            "known_gaps"
          ]
        },
        "cache_hit": {
          "type": "boolean"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "data_watermark",
        "identity_revision",
        "accuracy",
        "sample_rate",
        "coverage",
        "cache_hit",
        "generated_at"
      ]
    }
  },
  "required": [
    "query_id",
    "columns",
    "rows",
    "metadata"
  ]
}
