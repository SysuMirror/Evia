{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.activity.invalid/v1/query-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "description": "Query kind selecting the analysis engine and its config block. events returns bounded raw rows; journey traces one subject and requires a single identity filter; trend aggregates over optional time buckets and groups; funnel is ordered multi-step conversion; retention is a calendar cohort matrix; segment partitions a subject population into scalar groups; path counts ordered event sequences; attribution credits converters across touchpoints.",
      "enum": [
        "events",
        "trend",
        "funnel",
        "journey",
        "retention",
        "segment",
        "path",
        "attribution"
      ]
    },
    "environment": {
      "description": "Deployment scope. The query runs only against facts published in this environment, and for machine credentials it must match the granted environment.",
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "time_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "event_keys": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
        "maxLength": 68
      }
    },
    "filter": {
      "$ref": "#/$defs/filter"
    },
    "subject": {
      "description": "Subject identifier the per-subject analyses count on. uid uses the original UID, anonymous uses the raw anonymous device identifier (never a resolved person). resolved_person is reserved for a future identity graph and currently fails closed with IDENTITY_RESOLUTION_UNAVAILABLE.",
      "enum": [
        "uid",
        "anonymous",
        "resolved_person"
      ]
    },
    "identity_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "identity_filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "anonymous_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [],
      "minProperties": 1
    },
    "group_by": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "system"
              },
              "key": {
                "enum": [
                  "event_key",
                  "uid",
                  "anonymous_id",
                  "session_id",
                  "page_view_id",
                  "event_time",
                  "operation_id"
                ]
              }
            },
            "required": [
              "kind",
              "key"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "property"
              },
              "event_key": {
                "type": "string",
                "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
                "maxLength": 68
              },
              "schema_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              }
            },
            "required": [
              "kind",
              "event_key",
              "schema_version",
              "key"
            ]
          }
        ]
      }
    },
    "metrics": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op": {
            "description": "Aggregation operator. p50/p90/p95/p99 are exact (quantileExact) or approximate (quantileTDigest) percentiles over a numeric field.",
            "enum": [
              "count",
              "unique",
              "sum",
              "avg",
              "max",
              "min",
              "p50",
              "p90",
              "p95",
              "p99"
            ]
          },
          "field": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "system"
                  },
                  "key": {
                    "enum": [
                      "event_key",
                      "uid",
                      "anonymous_id",
                      "session_id",
                      "page_view_id",
                      "event_time",
                      "operation_id"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "key"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "property"
                  },
                  "event_key": {
                    "type": "string",
                    "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
                    "maxLength": 68
                  },
                  "schema_version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  }
                },
                "required": [
                  "kind",
                  "event_key",
                  "schema_version",
                  "key"
                ]
              }
            ]
          },
          "accuracy": {
            "description": "exact (the default) uses precise aggregation; approximate is accepted only for unique counts and the p50/p90/p95/p99 percentiles (ClickHouse uniqCombined64/quantileTDigest) and is rejected for every other operator.",
            "enum": [
              "exact",
              "approximate"
            ]
          }
        },
        "required": [
          "op"
        ]
      }
    },
    "interval": {
      "description": "Trend time bucket in the request timezone. Omit it to aggregate the whole range into one value. week starts on Monday (ClickHouse toStartOfWeek mode 1); month is intentionally not a trend interval because it is variable-duration.",
      "enum": [
        "minute",
        "hour",
        "day",
        "week"
      ]
    },
    "funnel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_key": {
                "type": "string",
                "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
                "maxLength": 68
              },
              "schema_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "filter": {
                "$ref": "#/$defs/filter"
              }
            },
            "required": [
              "event_key",
              "schema_version"
            ]
          }
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "mode": {
          "const": "ordered_with_interleaving"
        },
        "same_entity": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "step_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "field": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "system"
                      },
                      "key": {
                        "enum": [
                          "event_key",
                          "uid",
                          "anonymous_id",
                          "session_id",
                          "page_view_id",
                          "event_time",
                          "operation_id"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "key"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "property"
                      },
                      "event_key": {
                        "type": "string",
                        "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
                        "maxLength": 68
                      },
                      "schema_version": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      }
                    },
                    "required": [
                      "kind",
                      "event_key",
                      "schema_version",
                      "key"
                    ]
                  }
                ]
              }
            },
            "required": [
              "step_index",
              "field"
            ]
          }
        }
      },
      "required": [
        "steps",
        "window_seconds",
        "mode"
      ]
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_event": {
          "$ref": "#/$defs/retention_step"
        },
        "return_event": {
          "$ref": "#/$defs/retention_step"
        },
        "granularity": {
          "description": "Calendar cohort period. month aligns each cohort to the first day of its calendar month in the request timezone; the bounded raw-pull window for month uses a conservative 31-day-per-period upper bound.",
          "enum": [
            "day",
            "week",
            "month"
          ]
        },
        "periods": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      },
      "required": [
        "start_event",
        "return_event",
        "granularity",
        "periods"
      ]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/retention_step"
        },
        "field": {
          "$ref": "#/$defs/segment_field"
        }
      },
      "required": [
        "event",
        "field"
      ]
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_event": {
          "$ref": "#/$defs/retention_step"
        },
        "depth": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "collapse_repeats": {
          "type": "boolean",
          "description": "When true, fold consecutive identical event keys into one node before start-pin and depth extraction. Defaults to false so existing path results stay byte-stable."
        }
      },
      "required": [
        "depth"
      ]
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conversion": {
          "$ref": "#/$defs/retention_step"
        },
        "touchpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/retention_step"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "decay_half_life_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800,
          "description": "Half-life in seconds used only by the time_decay model; required when model is time_decay, ignored otherwise."
        },
        "model": {
          "type": "string",
          "description": "Multi-touch model. position_based applies U-shaped weights: the first and last distinct in-window touchpoint each receive 0.4, the middle touchpoints share 0.2 equally; two touchpoints split 0.5/0.5 and a single touchpoint receives full weight.",
          "enum": [
            "last_touch",
            "first_touch",
            "linear",
            "position_based",
            "time_decay"
          ]
        }
      },
      "required": [
        "conversion",
        "touchpoints",
        "window_seconds",
        "model"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "cursor": {
      "type": "string",
      "maxLength": 4096
    },
    "event_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_key": {
            "type": "string",
            "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
            "maxLength": 68
          },
          "schema_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "event_key",
          "schema_version"
        ]
      }
    }
  },
  "required": [
    "kind",
    "environment",
    "time_range",
    "timezone"
  ],
  "$defs": {
    "field": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "system"
            },
            "key": {
              "enum": [
                "event_key",
                "uid",
                "anonymous_id",
                "session_id",
                "page_view_id",
                "event_time",
                "operation_id"
              ]
            }
          },
          "required": [
            "kind",
            "key"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "property"
            },
            "event_key": {
              "type": "string",
              "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
              "maxLength": 68
            },
            "schema_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "kind",
            "event_key",
            "schema_version",
            "key"
          ]
        }
      ]
    },
    "retention_step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_key": {
          "type": "string",
          "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
          "maxLength": 68
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "filter": {
          "$ref": "#/$defs/filter"
        }
      },
      "required": [
        "event_key",
        "schema_version"
      ]
    },
    "segment_field": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "system"
            },
            "key": {
              "enum": [
                "event_key",
                "uid",
                "anonymous_id",
                "session_id",
                "page_view_id",
                "operation_id"
              ]
            }
          },
          "required": [
            "kind",
            "key"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "property"
            },
            "event_key": {
              "type": "string",
              "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
              "maxLength": 68
            },
            "schema_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "kind",
            "event_key",
            "schema_version",
            "key"
          ]
        }
      ]
    },
    "filter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "description": "Logical node combining 1-20 nested filter nodes. There is no generic NOT node; negation is expressed only through the explicit negated scalar operators (not_in/not_prefix/not_suffix/not_contains) so missing-key handling stays explicit.",
              "enum": [
                "and",
                "or"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/filter"
              }
            }
          },
          "required": [
            "op",
            "args"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "description": "Scalar comparison over one field. eq/neq are equality, in/not_in are set membership with an array value, gt/gte/lt/lte apply to numeric or datetime fields, and prefix/suffix/contains (string-only, ClickHouse startsWith/endsWith/position) each have an explicit not_* negation. Every leaf keeps the same scope/presence/validity guard; a negation only inverts the inner test, so absent keys, explicit nulls and wrongly typed values stay excluded. An empty not_in matches every present/valid row. User values are always bound parameters, never SQL text.",
              "enum": [
                "eq",
                "neq",
                "in",
                "not_in",
                "gt",
                "gte",
                "lt",
                "lte",
                "prefix",
                "not_prefix",
                "suffix",
                "not_suffix",
                "contains",
                "not_contains"
              ]
            },
            "field": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "system"
                    },
                    "key": {
                      "enum": [
                        "event_key",
                        "uid",
                        "anonymous_id",
                        "session_id",
                        "page_view_id",
                        "event_time",
                        "operation_id"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "key"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "property"
                    },
                    "event_key": {
                      "type": "string",
                      "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
                      "maxLength": 68
                    },
                    "schema_version": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                    }
                  },
                  "required": [
                    "kind",
                    "event_key",
                    "schema_version",
                    "key"
                  ]
                }
              ]
            },
            "value": {
              "anyOf": [
                {
                  "oneOf": [
                    {
                      "type": "string",
                      "maxLength": 1024
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "number",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  ]
                },
                {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "maxLength": 1024
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "number",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    ]
                  }
                }
              ]
            }
          },
          "required": [
            "op",
            "field",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "description": "Key-existence test within the pinned event/version. is_present matches when the key exists, including an explicit null; is_missing matches absent keys. Neither coerces a missing value into a default or a typed comparison.",
              "enum": [
                "is_missing",
                "is_present"
              ]
            },
            "field": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "system"
                    },
                    "key": {
                      "enum": [
                        "event_key",
                        "uid",
                        "anonymous_id",
                        "session_id",
                        "page_view_id",
                        "event_time",
                        "operation_id"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "key"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "property"
                    },
                    "event_key": {
                      "type": "string",
                      "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
                      "maxLength": 68
                    },
                    "schema_version": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                    }
                  },
                  "required": [
                    "kind",
                    "event_key",
                    "schema_version",
                    "key"
                  ]
                }
              ]
            }
          },
          "required": [
            "op",
            "field"
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "journey"
          }
        }
      },
      "then": {
        "required": [
          "identity_filter"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "funnel"
          }
        }
      },
      "then": {
        "required": [
          "funnel",
          "subject"
        ],
        "not": {
          "required": [
            "event_versions"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "retention"
          }
        }
      },
      "then": {
        "required": [
          "retention",
          "subject"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "event_versions"
              ]
            },
            {
              "required": [
                "event_keys"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "segment"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "subject"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "event_versions"
              ]
            },
            {
              "required": [
                "event_keys"
              ]
            },
            {
              "required": [
                "group_by"
              ]
            },
            {
              "required": [
                "metrics"
              ]
            },
            {
              "required": [
                "interval"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "path"
          }
        }
      },
      "then": {
        "required": [
          "path",
          "subject"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "event_versions"
              ]
            },
            {
              "required": [
                "event_keys"
              ]
            },
            {
              "required": [
                "group_by"
              ]
            },
            {
              "required": [
                "metrics"
              ]
            },
            {
              "required": [
                "interval"
              ]
            }
          ]
        }
      }
    },
