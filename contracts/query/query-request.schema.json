{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.activity.invalid/v1/query-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "description": "Query kind selecting the analysis engine and its config block. events returns bounded raw rows; journey traces one subject and requires a single identity filter; trend aggregates over optional time buckets and groups; funnel is ordered multi-step conversion; retention is a calendar cohort matrix; segment partitions a subject population into scalar groups; path counts ordered event sequences; attribution credits converters across touchpoints; heatmap aggregates fixed sys.heatmap_click v1 coordinates into a fixed 20x10 viewport grid. experiment compares variants from an exposure event against a post-exposure outcome with SRM and statistical significance tests.",
      "enum": [
        "events",
        "trend",
        "funnel",
        "journey",
        "retention",
        "segment",
        "path",
        "attribution",
        "heatmap",
        "experiment"
      ]
    },
    "environment": {
      "description": "Deployment scope. The query runs only against facts published in this environment, and for machine credentials it must match the granted environment.",
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "time_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "event_keys": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
        "maxLength": 68
      }
    },
    "filter": {
      "$ref": "#/$defs/filter"
    },
    "subject": {
      "description": "Subject identifier the per-subject analyses count on. uid uses the original UID, anonymous uses the raw anonymous device identifier. resolved_person groups identities through the versioned identity graph: the request is expanded at enqueue time against the pinned (or latest completed) identity revision, bounded by the identity expansion budgets (IDENTITY_EXPANSION_EXCEEDED otherwise). Journeys stay single-raw-identity and reject resolved_person; raw-row event listings require identity_filter.resolved_person_id.",
      "enum": [
        "uid",
        "anonymous",
        "resolved_person"
      ]
    },
    "identity_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Pins the identity graph revision a resolved_person query expands against. Omitting it resolves the scope's latest completed revision and the result metadata reports the revision actually used. Only the latest completed revision is expandable until historical member snapshots exist; older or unknown pins fail closed with IDENTITY_REVISION_NOT_FOUND / IDENTITY_REVISION_NOT_RESOLVABLE."
    },
    "identity_filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "anonymous_id": {
          "type": "string",
          "format": "uuid"
        },
        "resolved_person_id": {
          "type": "string",
          "format": "uuid",
          "description": "Pins one resolved person for a resolved_person subject query; the server expands it into a bounded raw-identity member predicate of the pinned identity revision."
        }
      },
      "required": [],
      "minProperties": 1
    },
    "group_by": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "system"
              },
              "key": {
                "description": "Selectable built-in system column (not a custom property, which uses kind=property with an event-scoped key). event_key is the event type; uid/anonymous_id are the subject identifiers; session_id/page_view_id/operation_id are execution-context columns; event_time is the only datetime system field. Presence and empty-string guards differ by column.",
                "enum": [
                  "event_key",
                  "uid",
                  "anonymous_id",
                  "session_id",
                  "page_view_id",
                  "event_time",
                  "operation_id"
                ]
              }
            },
            "required": [
              "kind",
              "key"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "property"
              },
              "event_key": {
                "type": "string",
                "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
                "maxLength": 68
              },
              "schema_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              }
            },
            "required": [
              "kind",
              "event_key",
              "schema_version",
              "key"
            ]
          }
        ]
      }
    },
    "metrics": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op": {
            "description": "Aggregation operator. p50/p90/p95/p99 are exact (quantileExact) or approximate (quantileTDigest) percentiles over a numeric field.",
            "enum": [
              "count",
              "unique",
              "sum",
              "avg",
              "max",
              "min",
              "p50",
              "p90",
              "p95",
              "p99"
            ]
          },
          "field": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "system"
                  },
                  "key": {
                    "description": "Selectable built-in system column (not a custom property, which uses kind=property with an event-scoped key). event_key is the event type; uid/anonymous_id are the subject identifiers; session_id/page_view_id/operation_id are execution-context columns; event_time is the only datetime system field. Presence and empty-string guards differ by column.",
                    "enum": [
                      "event_key",
                      "uid",
                      "anonymous_id",
                      "session_id",
                      "page_view_id",
                      "event_time",
                      "operation_id"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "key"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "property"
                  },
                  "event_key": {
                    "type": "string",
                    "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
                    "maxLength": 68
                  },
                  "schema_version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  }
                },
                "required": [
                  "kind",
                  "event_key",
                  "schema_version",
                  "key"
                ]
              }
            ]
          },
          "accuracy": {
            "description": "exact (the default) uses precise aggregation; approximate is accepted only for unique counts and the p50/p90/p95/p99 percentiles (ClickHouse uniqCombined64/quantileTDigest) and is rejected for every other operator.",
            "enum": [
              "exact",
              "approximate"
            ]
          }
        },
        "required": [
          "op"
        ]
      }
    },
    "interval": {
      "description": "Trend time bucket in the request timezone. Omit it to aggregate the whole range into one value. week starts on Monday (ClickHouse toStartOfWeek mode 1); month is intentionally not a trend interval because it is variable-duration.",
      "enum": [
        "minute",
        "hour",
        "day",
        "week"
      ]
    },
    "funnel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_key": {
                "type": "string",
                "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
                "maxLength": 68
              },
              "schema_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "filter": {
                "$ref": "#/$defs/filter"
              }
            },
            "required": [
              "event_key",
              "schema_version"
            ]
          }
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "mode": {
          "const": "ordered_with_interleaving"
        },
        "same_entity": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "step_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "field": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "system"
                      },
                      "key": {
                        "description": "Selectable built-in system column (not a custom property, which uses kind=property with an event-scoped key). event_key is the event type; uid/anonymous_id are the subject identifiers; session_id/page_view_id/operation_id are execution-context columns; event_time is the only datetime system field. Presence and empty-string guards differ by column.",
                        "enum": [
                          "event_key",
                          "uid",
                          "anonymous_id",
                          "session_id",
                          "page_view_id",
                          "event_time",
                          "operation_id"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "key"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "property"
                      },
                      "event_key": {
                        "type": "string",
                        "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
                        "maxLength": 68
                      },
                      "schema_version": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      }
                    },
                    "required": [
                      "kind",
                      "event_key",
                      "schema_version",
                      "key"
                    ]
                  }
                ]
              }
            },
            "required": [
              "step_index",
              "field"
            ]
          }
        }
      },
      "required": [
        "steps",
        "window_seconds",
        "mode"
      ]
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_event": {
          "$ref": "#/$defs/retention_step"
        },
        "return_event": {
          "$ref": "#/$defs/retention_step"
        },
        "granularity": {
          "description": "Calendar cohort period. month aligns each cohort to the first day of its calendar month in the request timezone; the bounded raw-pull window for month uses a conservative 31-day-per-period upper bound.",
          "enum": [
            "day",
            "week",
            "month"
          ]
        },
        "periods": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      },
      "required": [
        "start_event",
        "return_event",
        "granularity",
        "periods"
      ]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/retention_step"
        },
        "field": {
          "$ref": "#/$defs/segment_field"
        }
      },
      "required": [
        "event",
        "field"
      ]
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_event": {
          "$ref": "#/$defs/retention_step"
        },
        "depth": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "collapse_repeats": {
          "type": "boolean",
          "description": "When true, fold consecutive identical event keys into one node before start-pin and depth extraction. Defaults to false so existing path results stay byte-stable."
        }
      },
      "required": [
        "depth"
      ]
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conversion": {
          "$ref": "#/$defs/retention_step"
        },
        "touchpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/retention_step"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "decay_half_life_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800,
          "description": "Half-life in seconds used only by the time_decay model; required when model is time_decay, ignored otherwise."
        },
        "model": {
          "type": "string",
          "description": "Multi-touch model. position_based applies U-shaped weights: the first and last distinct in-window touchpoint each receive 0.4, the middle touchpoints share 0.2 equally; two touchpoints split 0.5/0.5 and a single touchpoint receives full weight.",
          "enum": [
            "last_touch",
            "first_touch",
            "linear",
            "position_based",
            "time_decay"
          ]
        }
      },
      "required": [
        "conversion",
        "touchpoints",
        "window_seconds",
        "model"
      ]
    },
    "heatmap": {
      "type": "object",
      "additionalProperties": false,
      "description": "Bounded click heatmap over fixed sys.heatmap_click schema version 1. Matches exactly one route_name or route_template with exact, responsive bucket, or all-viewport aggregation, returning either fixed 20x10 coordinate bins (mode=grid) or bounded Top-N element_path rankings (mode=elements).",
      "properties": {
        "route_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "route_template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mode": {
          "enum": [
            "grid",
            "elements"
          ]
        },
        "viewport_scope": {
          "enum": [
            "exact",
            "bucket",
            "all"
          ]
        },
        "viewport_bucket": {
          "enum": [
            "mobile",
            "tablet",
            "desktop"
          ]
        },
        "viewport_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "viewport_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "route_name"
              ],
              "not": {
                "required": [
                  "route_template"
                ]
              }
            },
            {
              "required": [
                "route_template"
              ],
              "not": {
                "required": [
                  "route_name"
                ]
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "viewport_scope": {
                  "const": "exact"
                }
              },
              "required": [
                "viewport_width",
                "viewport_height"
              ],
              "not": {
                "required": [
                  "viewport_bucket"
                ]
              }
            },
            {
              "properties": {
                "viewport_scope": {
                  "const": "bucket"
                }
              },
              "required": [
                "viewport_scope",
                "viewport_bucket"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "viewport_width"
                    ]
                  },
                  {
                    "required": [
                      "viewport_height"
                    ]
                  }
                ]
              }
            },
            {
              "properties": {
                "viewport_scope": {
                  "const": "all"
                }
              },
              "required": [
                "viewport_scope"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "viewport_width"
                    ]
                  },
                  {
                    "required": [
                      "viewport_height"
                    ]
                  },
                  {
                    "required": [
                      "viewport_bucket"
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "cursor": {
      "type": "string",
      "maxLength": 4096
    },
    "event_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_key": {
            "type": "string",
            "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
            "maxLength": 68
          },
          "schema_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "event_key",
          "schema_version"
        ]
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "description": "A/B experiment evaluation comparing variants assigned by earliest exposure against an in-window outcome event.",
      "properties": {
        "exposure_event": {
          "$ref": "#/$defs/retention_step"
        },
        "variant_field": {
          "$ref": "#/$defs/segment_field"
        },
        "control_variant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "outcome_event": {
          "$ref": "#/$defs/retention_step"
        },
        "metric_mode": {
          "type": "string",
          "enum": [
            "conversion",
            "numeric_mean"
          ],
          "description": "conversion computes binary subject conversion rate (two-proportion Z-test); numeric_mean sums outcome_value_field per exposed subject (Welch t-test)."
        },
        "outcome_value_field": {
          "$ref": "#/$defs/segment_field"
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000,
          "description": "Post-exposure outcome attribution window in seconds (1 minute to 30 days)."
        },
        "expected_splits": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "description": "Optional expected traffic weights (basis points) per variant for the SRM chi-squared test; omitted defaults to equal split across observed variants."
        }
      },
      "required": [
        "exposure_event",
        "variant_field",
        "control_variant",
        "outcome_event",
        "metric_mode",
        "window_seconds"
      ]
    }
  },
  "required": [
    "kind",
    "environment",
    "time_range",
    "timezone"
  ],
  "$defs": {
    "field": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "system"
            },
            "key": {
              "description": "Selectable built-in system column (not a custom property, which uses kind=property with an event-scoped key). event_key is the event type; uid/anonymous_id are the subject identifiers; session_id/page_view_id/operation_id are execution-context columns; event_time is the only datetime system field. Presence and empty-string guards differ by column.",
              "enum": [
                "event_key",
                "uid",
                "anonymous_id",
                "session_id",
                "page_view_id",
                "event_time",
                "operation_id"
              ]
            }
          },
          "required": [
            "kind",
            "key"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "property"
            },
            "event_key": {
              "type": "string",
              "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
              "maxLength": 68
            },
            "schema_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "kind",
            "event_key",
            "schema_version",
            "key"
          ]
        }
      ]
    },
    "retention_step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_key": {
          "type": "string",
          "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
          "maxLength": 68
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "filter": {
          "$ref": "#/$defs/filter"
        }
      },
      "required": [
        "event_key",
        "schema_version"
      ]
    },
    "segment_field": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "system"
            },
            "key": {
              "description": "Selectable built-in system column (not a custom property, which uses kind=property with an event-scoped key). event_key is the event type; uid/anonymous_id are the subject identifiers; session_id/page_view_id/operation_id are execution-context columns; event_time is the only datetime system field. Presence and empty-string guards differ by column.",
              "enum": [
                "event_key",
                "uid",
                "anonymous_id",
                "session_id",
                "page_view_id",
                "operation_id"
              ]
            }
          },
          "required": [
            "kind",
            "key"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "property"
            },
            "event_key": {
              "type": "string",
              "pattern": "^(sys\\.)?[a-z][a-z0-9_]{0,63}$",
              "maxLength": 68
            },
            "schema_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "kind",
            "event_key",
            "schema_version",
            "key"
          ]
        }
      ]
    },
    "filter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "description": "Logical node combining 1-20 nested filter nodes. There is no generic NOT node; negation is expressed only through the explicit negated scalar operators (not_in/not_prefix/not_suffix/not_contains) so missing-key handling stays explicit.",
              "enum": [
                "and",
                "or"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/filter"
              }
            }
          },
          "required": [
            "op",
            "args"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "description": "Scalar comparison over one field. eq/neq are equality, in/not_in are set membership with an array value, gt/gte/lt/lte apply to numeric or datetime fields, and prefix/suffix/contains (string-only, ClickHouse startsWith/endsWith/position) each have an explicit not_* negation. Every leaf keeps the same scope/presence/validity guard; a negation only inverts the inner test, so absent keys, explicit nulls and wrongly typed values stay excluded. An empty not_in matches every present/valid row. User values are always bound parameters, never SQL text.",
              "enum": [
                "eq",
                "neq",
                "in",
                "not_in",
