# Local development only; see docs/runbooks/development.md for random generation.
# Replace every placeholder; never commit .env or use this HTTP setup publicly.
EVIA_POSTGRES_PASSWORD=replace-with-random-password
EVIA_DATABASE_URL=postgres://evia:replace-with-random-password@127.0.0.1:55432/evia?sslmode=disable
EVIA_LISTEN=127.0.0.1:8080
EVIA_PUBLIC_ORIGIN=http://127.0.0.1:5173
EVIA_ALLOW_INSECURE_HTTP=true
# Generate with: openssl rand -hex 32
EVIA_CURSOR_KEY=replace-with-64-hex-characters
EVIA_BOOTSTRAP_USERNAME=admin
EVIA_BOOTSTRAP_DISPLAY_NAME=Administrator
EVIA_BOOTSTRAP_PASSWORD=replace-with-a-password-of-12-to-72-bytes
# Optional OAuth2 / UniSSO external login (never commit real secrets or production domains)
# EVIA_OAUTH2_UNISSO_ISSUER=https://sso.example.com
# EVIA_OAUTH2_UNISSO_CLIENT_ID=replace-with-client-id
# EVIA_OAUTH2_UNISSO_CLIENT_SECRET=replace-with-client-secret
# EVIA_OAUTH2_UNISSO_REDIRECT_URI=https://evia.example.com/user/login/oauth2/callback
# EVIA_OAUTH2_UNISSO_SCOPES="openid profile:username profile:name email"
