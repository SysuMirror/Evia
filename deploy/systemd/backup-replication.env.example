# Copy to /etc/evia/backup-replication.env and restrict to root (chmod 0600).
# The replication config references these variables by name; values never
# appear in argv, object keys, state files or run reports.

EVIA_S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
EVIA_S3_SECRET_KEY=CHANGE_ME_SECRET_KEY

# When pointing at a local MinIO/Ceph endpoint, the schedule config sets
# "insecure_http": true. Production S3 stays on TLS and leaves this unset.
