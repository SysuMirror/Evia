# Copy to /etc/evia/backup-drill.env and restrict to root (chmod 0600).
# The schedule config references these variables by name; values never appear
# in argv, metric labels or run reports.

# PostgreSQL control database DSN consumed by pg_dump/pg_restore via libpq.
EVIA_BACKUP_PG_DSN=postgres://evia:CHANGE_ME@db.internal:5432/evia?sslmode=require

# ClickHouse native client invocation. The default matches the dev container
# setup; production deployments point at the clickhouse-client binary directly.
EVIA_CH_CLIENT=docker exec evia-pipeline-dev-clickhouse-1 clickhouse client
EVIA_CH_USERNAME=evia
EVIA_CH_PASSWORD=CHANGE_ME
